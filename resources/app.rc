#include <windows.h>
#include "Version.h"
#include "resource.h"
100 ICON "redlight.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION REDLIGHT_VERSION_TUPLE
 PRODUCTVERSION REDLIGHT_VERSION_TUPLE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "RedLight contributors\0"
   VALUE "FileDescription", "RedLight red-only display filter\0"
   VALUE "FileVersion", REDLIGHT_VERSION "\0"
   VALUE "InternalName", "RedLight\0"
   VALUE "OriginalFilename", "RedLight.exe\0"
   VALUE "ProductName", "RedLight\0"
   VALUE "ProductVersion", REDLIGHT_VERSION "\0"
   VALUE "LegalCopyright", "GPL-3.0; see LICENSE\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

IDD_CUSTOM_SESSION_LIMIT DIALOGEX 0, 0, 240, 120
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Auto-restore time limit"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "&Minutes (0 = unlimited, maximum 240):", -1, 12, 12, 216, 12
 EDITTEXT IDC_SESSION_MINUTES, 12, 29, 64, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Changed nonzero limits start from now while on. The current value keeps its deadline.", -1, 12, 54, 216, 32
 DEFPUSHBUTTON "&Apply", IDOK, 116, 96, 52, 14
 PUSHBUTTON "&Cancel", IDCANCEL, 176, 96, 52, 14
END
