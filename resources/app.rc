#include <windows.h>
#include "Version.h"
#include "resource.h"
100 ICON "redlight.ico"
IDI_TRAY_OFF ICON "tray-off.ico"
IDI_TRAY_STRICT ICON "tray-strict.ico"
IDI_TRAY_LUMA ICON "tray-luma.ico"
IDI_TRAY_ATTENTION ICON "tray-attention.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION REDLIGHT_VERSION_TUPLE
 PRODUCTVERSION REDLIGHT_VERSION_TUPLE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "RedLight contributors\0"
   VALUE "FileDescription", "RedLight red-only display filter\0"
   VALUE "FileVersion", REDLIGHT_VERSION "\0"
   VALUE "InternalName", "RedLight\0"
   VALUE "OriginalFilename", "RedLight.exe\0"
   VALUE "ProductName", "RedLight\0"
   VALUE "ProductVersion", REDLIGHT_VERSION "\0"
   VALUE "LegalCopyright", "GPL-3.0; see LICENSE\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

IDD_CUSTOM_SESSION_LIMIT DIALOGEX 0, 0, 240, 120
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Auto-restore time limit"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "&Minutes (0 = unlimited, maximum 240):", -1, 12, 12, 216, 12
 EDITTEXT IDC_SESSION_MINUTES, 12, 29, 64, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Changed nonzero limits start from now while on. The current value keeps its deadline.", -1, 12, 54, 216, 32
 DEFPUSHBUTTON "&Apply", IDOK, 116, 96, 52, 14
 PUSHBUTTON "&Cancel", IDCANCEL, 176, 96, 52, 14
END

IDD_RED_BRIGHTNESS DIALOGEX 0, 0, 240, 124
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Red brightness"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Red brightness (&percent, 1-100):", -1, 12, 12, 216, 12
 EDITTEXT IDC_RED_BRIGHTNESS, 12, 29, 64, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "100% keeps the existing filter brightness. Gamma stays at 100%; your choice is kept for Magnification.", -1, 12, 54, 216, 32
 DEFPUSHBUTTON "&Apply", IDOK, 116, 100, 52, 14
 PUSHBUTTON "&Cancel", IDCANCEL, 176, 100, 52, 14
END

IDD_DAILY_SCHEDULE DIALOGEX 0, 0, 280, 174
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Daily schedule"
FONT 9, "Segoe UI"
BEGIN
 CONTROL "&Enable automatic daily filtering", IDC_SCHEDULE_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 256, 12
 LTEXT "&Turn on at (HH:MM):", -1, 12, 35, 132, 12
 EDITTEXT IDC_SCHEDULE_ENABLE_AT, 154, 32, 64, 15, ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "&Restore at (HH:MM):", -1, 12, 58, 132, 12
 EDITTEXT IDC_SCHEDULE_RESTORE_AT, 154, 55, 64, 15, ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Windows local time, 24-hour format. Only future triggers run while RedLight and its controls are available. Startup/wake never catches up; missed times are skipped.", -1, 12, 80, 256, 38
 LTEXT "Manual controls last until the next future trigger. Restore and Exit remain immediate. Start with Windows is separate.", -1, 12, 120, 256, 22
 DEFPUSHBUTTON "&Apply", IDOK, 156, 150, 52, 14
 PUSHBUTTON "&Cancel", IDCANCEL, 216, 150, 52, 14
END
